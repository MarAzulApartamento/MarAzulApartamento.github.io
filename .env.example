# Apartamento Mar Azul — environment variable template
# Copy this file to .env and fill in real values.
# .env is gitignored and must NEVER be committed.
# In production (Cloudflare Pages), set these via the dashboard's Environment Variables panel.

# ---- Lodgify ----
# Public API key from Lodgify dashboard: Settings → Public API
# Used for: pulling rates, properties, reviews, quotes into our own pages.
LODGIFY_API_KEY=

# Lodgify property ID (numeric, public — found in dashboard URL or property settings)
LODGIFY_PROPERTY_ID=

# Lodgify Booking Engine widget code/ID (public — used in JS embeds)
LODGIFY_WIDGET_ID=

# ---- Site ----
SITE_URL=https://apartamentomarazul.com
DEFAULT_LOCALE=en
SUPPORTED_LOCALES=en,pt,de,nl,fr

# ---- Analytics (set to empty to disable that tracker) ----
# GA4 Measurement ID, e.g. G-XXXXXXXXXX
PUBLIC_GA4_ID=

# Microsoft Clarity Project ID
PUBLIC_CLARITY_ID=

# Cloudflare Web Analytics token — set in Cloudflare dashboard, exposed at runtime
PUBLIC_CF_ANALYTICS_TOKEN=

# ---- WhatsApp ----
# International format with country code, no '+' or spaces. Example for PT: 351912345678
PUBLIC_WHATSAPP_NUMBER=
PUBLIC_WHATSAPP_DEFAULT_MESSAGE=Olá! I'm interested in Apartamento Mar Azul.

# ---- Email (Lodgify-managed in v1; reserved if we ever add another ESP) ----
# (intentionally empty)
