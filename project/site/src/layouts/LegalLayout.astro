---
import BaseLayout from './BaseLayout.astro';
import TopBar from '../components/TopBar.astro';
import Footer from '../components/Footer.astro';
import { render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'legal'>;
  lang: string;
}

const { entry, lang } = Astro.props;
const { Content } = await render(entry);
---

<BaseLayout title={`${entry.data.title} · Apartamento Mar Azul`} description={entry.data.description} lang={lang}>
  <TopBar lang={lang} />

  <main id="main">
    <article class="legal">
      <div class="container legal-inner">
        <header class="legal-head">
          <p class="eyebrow">Legal</p>
          <h1 class="h1">{entry.data.title}</h1>
          <p class="muted small">Last updated: {entry.data.lastUpdated}</p>
        </header>
        <div class="legal-body">
          <Content />
        </div>
      </div>
    </article>
  </main>

  <Footer />
</BaseLayout>

<style>
  .legal {
    background: var(--color-warm-white);
    padding: 56px 0 96px;
  }
  .legal-inner { max-width: 760px; }
  .legal-head { margin-bottom: 40px; padding-bottom: 24px; border-bottom: 1px solid #E5DED1; }
  .h1 {
    font: 700 clamp(34px, 4.6vw, 52px)/1.1 var(--font-display);
    letter-spacing: -0.015em;
    color: var(--color-deep-navy);
    margin: 8px 0 12px;
    text-wrap: balance;
    max-width: 16ch;
  }
  .legal-head .small { font-size: 14px; line-height: 1.5; margin: 0; }
  .legal-body :global(h2) {
    font: 700 clamp(22px, 2.4vw, 28px)/1.2 var(--font-display);
    color: var(--color-deep-navy);
    margin: 40px 0 14px;
    letter-spacing: -0.005em;
  }
  .legal-body :global(h3) {
    font: 600 18px/1.3 var(--font-body);
    color: var(--color-deep-navy);
    margin: 28px 0 8px;
  }
  .legal-body :global(p) {
    font: 400 16px/1.65 var(--font-body);
    color: var(--color-deep-navy);
    margin: 0 0 16px;
    max-width: 65ch;
  }
  .legal-body :global(ul),
  .legal-body :global(ol) {
    font: 400 16px/1.65 var(--font-body);
    color: var(--color-deep-navy);
    margin: 0 0 16px;
    padding-left: 22px;
  }
  .legal-body :global(li) { margin: 0 0 6px; max-width: 60ch; }
  .legal-body :global(a) {
    color: var(--color-atlantic-blue);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
  }
  .legal-body :global(table) {
    border-collapse: collapse;
    width: 100%;
    margin: 16px 0 24px;
    font: 400 15px/1.5 var(--font-body);
  }
  .legal-body :global(th),
  .legal-body :global(td) {
    border: 1px solid #E5DED1;
    padding: 10px 14px;
    text-align: left;
    vertical-align: top;
  }
  .legal-body :global(th) {
    background: #F1EEE7;
    font-weight: 600;
    color: var(--color-deep-navy);
  }
  .legal-body :global(strong) { color: var(--color-deep-navy); }
  .legal-body :global(em) { font-style: italic; }
  .legal-body :global(hr) {
    border: 0;
    border-top: 1px solid #E5DED1;
    margin: 32px 0;
  }
</style>
