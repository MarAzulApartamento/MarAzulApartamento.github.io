---
import BaseLayout from '../layouts/BaseLayout.astro';
import TopBar from '../components/TopBar.astro';
import Footer from '../components/Footer.astro';
import CalendarPicker from '../components/CalendarPicker.astro';
import { SITE, WHATSAPP } from '../lib/config';
import { fetchPriceData, fetchCalendarData } from '../lib/lodgify';

const price = await fetchPriceData();
const calendar = await fetchCalendarData(6);
const whatsappHref = WHATSAPP.number
  ? `https://wa.me/${WHATSAPP.number}?text=${encodeURIComponent(WHATSAPP.defaultMessage)}`
  : '#whatsapp';
---

<BaseLayout
  title={`Book direct · ${SITE.name}`}
  description="Book your stay at Apartamento Mar Azul direct. Best rate available, every time. Free parking, late check-out, direct WhatsApp line with the host."
  lang="en"
>
  <TopBar lang="en" />

  <main id="main">
    <div class="book-page">
      <div class="container book-inner">
        <a class="back" href="/">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
          <span>Back to the apartment</span>
        </a>

        <div class="book-grid">
          <div class="book-copy">
            <p class="eyebrow">Booking</p>
            <h1 class="h1">Pick your dates.</h1>
            <p class="lede">
              Best rate available, every time. Booking direct includes free
              parking, late check-out and early check-in when the calendar
              allows, and a direct WhatsApp line with Stefania.
            </p>

            <ul class="book-perks">
              <li>
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>
                <span>From €{price.min} per night · {price.minStay}-night minimum</span>
              </li>
              <li>
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>
                <span>Free parking, free Wi-Fi, linens included</span>
              </li>
              <li>
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>
                <span>Free cancellation up to 7 days before arrival</span>
              </li>
              <li>
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>
                <span>Best rate available, no platform service fees</span>
              </li>
            </ul>

            <p class="book-help muted">
              Questions before you book?
              <a href={whatsappHref} target={WHATSAPP.number ? '_blank' : undefined} rel={WHATSAPP.number ? 'noopener noreferrer' : undefined}>
                WhatsApp Stefy
              </a>
              <span class="book-help-meta">{WHATSAPP.responseTime}</span>
            </p>
          </div>

          <div class="book-widget">
            <CalendarPicker data={calendar} visibleMonths={2} ctaLabel="Book direct →" />
            <p class="book-widget-note muted">
              Booking opens Lodgify's secure checkout in a new tab once you click "Book direct".
            </p>
          </div>
        </div>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>

<style>
  .book-page {
    background: var(--color-warm-white);
    min-height: calc(100vh - 200px);
    padding: 48px 0 96px;
    animation: bookin 220ms ease-out;
  }
  @keyframes bookin { from { opacity: 0; } to { opacity: 1; } }
  @media (prefers-reduced-motion: reduce) { .book-page { animation: none; } }

  .book-inner { max-width: 1200px; }

  .back {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--color-atlantic-blue);
    font: 500 14px/1 var(--font-body);
    text-decoration: none;
    margin-bottom: 32px;
  }
  .back:hover { text-decoration: underline; text-underline-offset: 3px; }

  .book-grid {
    display: grid;
    grid-template-columns: 5fr 7fr;
    gap: 56px;
    align-items: start;
  }

  .h1 {
    font: 700 clamp(36px, 4.6vw, 56px)/1.05 var(--font-display);
    letter-spacing: -0.015em;
    color: var(--color-deep-navy);
    margin: 8px 0 16px;
    text-wrap: balance;
    max-width: 14ch;
  }

  .book-perks {
    list-style: none;
    padding: 0;
    margin: 28px 0 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .book-perks li {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    font: 400 16px/1.5 var(--font-body);
    color: var(--color-deep-navy);
  }
  .book-perks svg {
    flex: 0 0 auto;
    margin-top: 4px;
    color: var(--color-atlantic-blue);
  }

  .book-help {
    margin-top: 32px;
    padding-top: 20px;
    border-top: 1px solid #E5DED1;
    font: 400 15px/1.5 var(--font-body);
    color: var(--color-slate-grey);
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }
  .book-help a {
    color: var(--color-atlantic-blue);
    font-weight: 600;
  }
  .book-help-meta { font-size: 13px; }

  .book-widget-note {
    margin-top: 14px;
    font-size: 13px;
    line-height: 1.5;
    text-align: center;
  }

  @media (max-width: 900px) {
    .book-grid { grid-template-columns: 1fr; gap: 32px; }
  }
</style>
