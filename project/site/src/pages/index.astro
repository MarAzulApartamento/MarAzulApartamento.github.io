---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Apartamento Mar Azul · Lagos, Algarve"
  description="A private apartment in Lagos, Algarve. 2-4 guests, terrace, A/C, Wi-Fi, free parking. 5 min by car from Dona Ana Beach."
  lang="en"
>
  <main class="mx-auto max-w-3xl px-6 py-24">
    <p class="text-sm uppercase tracking-widest text-(--color-slate-grey)">Sprint 0 · Scaffold</p>
    <h1 class="mt-4 text-(length:--text-hero) font-bold">Apartamento Mar Azul</h1>
    <p class="mt-6 text-lg text-(--color-slate-grey)">
      The Astro scaffold is in place. Real content arrives in Sprint 1 (design system) and Sprint 2 (build).
    </p>
  </main>
</BaseLayout>
