---
import BaseLayout from '../layouts/BaseLayout.astro';
import TopBar from '../components/TopBar.astro';
import Hero from '../components/Hero.astro';
import TrustStrip from '../components/TrustStrip.astro';
import FactsGrid from '../components/FactsGrid.astro';
import About from '../components/About.astro';
import Gallery from '../components/Gallery.astro';
import Perks from '../components/Perks.astro';
import Location from '../components/Location.astro';
import Reviews from '../components/Reviews.astro';
import Availability from '../components/Availability.astro';
import FAQ from '../components/FAQ.astro';
import FinalCTA from '../components/FinalCTA.astro';
import StickyCTA from '../components/StickyCTA.astro';
import Footer from '../components/Footer.astro';
import { fetchPriceData, fetchCalendarData } from '../lib/lodgify';
import { getStrings, interp } from '../lib/i18n';

const price = await fetchPriceData();
const calendar = await fetchCalendarData(6);
const t = getStrings('en');
---

<BaseLayout
  title={t.home.metaTitle}
  description={interp(t.home.metaDescription, { priceFrom: price.min })}
  lang="en"
  preloadImage="/photos/marazul-01.jpg"
>
  <TopBar lang="en" />

  <main id="main">
    <Hero priceFrom={price.min} minStay={price.minStay} />
    <TrustStrip reviewCount={5} rating={5.0} />
    <FactsGrid />
    <About />
    <Gallery />
    <Perks />
    <Location />
    <Reviews />
    <Availability data={calendar} />
    <FAQ />
    <FinalCTA />
  </main>

  <Footer />
  <StickyCTA priceFrom={price.min} />
</BaseLayout>
