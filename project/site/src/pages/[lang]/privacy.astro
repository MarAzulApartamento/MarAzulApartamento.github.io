---
import LegalLayout from '../../layouts/LegalLayout.astro';
import { getCollection } from 'astro:content';
import { LOCALES, DEFAULT_LOCALE } from '../../lib/config';

export function getStaticPaths() {
  return LOCALES
    .filter((l) => l !== DEFAULT_LOCALE)
    .map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const all = await getCollection('legal', ({ data }) => data.page === 'privacy');
// Prefer the locale-specific entry; fall back to English while translations are pending.
const entry = all.find((e) => e.data.language === lang) || all.find((e) => e.data.language === 'en');
if (!entry) throw new Error('Missing privacy-en.md');
---

<LegalLayout entry={entry} lang={lang} />
