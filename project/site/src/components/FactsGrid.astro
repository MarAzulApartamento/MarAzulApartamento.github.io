---
import { getStrings } from '../lib/i18n';
const t = getStrings(Astro.currentLocale);
const facts = t.factsGrid.facts as Array<{ label: string; value: string; neg?: boolean }>;
---

<section class="section">
  <div class="container">
    <p class="eyebrow">{t.factsGrid.eyebrow}</p>
    <h2 class="h2">{t.factsGrid.title}</h2>
    <div class="facts">
      {facts.map((f) => (
        <div class={`fact${f.neg ? ' is-neg' : ''}`}>
          <span class="fact-label">{f.label}</span>
          <span class="fact-value">{f.value}</span>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .facts {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 1px;
    background: #E5DED1;
    border: 1px solid #E5DED1;
    border-radius: 12px;
    overflow: hidden;
    margin-top: 24px;
  }
  .fact {
    background: var(--color-warm-white);
    padding: 18px 18px 20px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .fact-label {
    font: 600 12px/1 var(--font-body);
    letter-spacing: 0.06em;
    color: var(--color-slate-grey);
  }
  .fact-value {
    font: 700 17px/1.2 var(--font-display);
    letter-spacing: -0.01em;
    color: var(--color-deep-navy);
  }
  .fact.is-neg .fact-value {
    color: var(--color-slate-grey);
    font-weight: 400;
    font-style: italic;
  }
  @media (max-width: 900px) {
    .facts { grid-template-columns: repeat(2, 1fr); }
  }
</style>
