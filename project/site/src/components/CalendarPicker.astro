---
import type { CalendarData } from '../lib/lodgify';
import { WHATSAPP } from '../lib/config';
import { getStrings, interp } from '../lib/i18n';

interface Props {
  data: CalendarData;
  visibleMonths?: number;
  ctaLabel?: string;
}

const { data, visibleMonths = 2, ctaLabel } = Astro.props;
const t = getStrings(Astro.currentLocale);

const lang = Astro.currentLocale || 'en';
const localeMap: Record<string, string> = {
  en: 'en-GB', pt: 'pt-PT', es: 'es-ES', it: 'it-IT',
  de: 'de-DE', nl: 'nl-NL', fr: 'fr-FR',
};
const localeCode = localeMap[lang] || 'en-GB';

const monthStarts = data.monthsCovered;

function monthMeta(isoStart: string) {
  const [yearStr, monthStr] = isoStart.split('-');
  const year = parseInt(yearStr, 10);
  const month = parseInt(monthStr, 10) - 1;
  const refDate = new Date(year, month, 1);
  const monthName = refDate.toLocaleString(localeCode, { month: 'long', year: 'numeric' });
  const daysInMonth = new Date(year, month + 1, 0).getDate();
  const firstWeekdayMondayBased = (refDate.getDay() + 6) % 7;
  return { year, month, monthName, daysInMonth, firstWeekdayMondayBased };
}

const monthsToRender = monthStarts.map((iso) => ({ iso, ...monthMeta(iso) }));

const _today = new Date();
const todayIso = `${_today.getFullYear()}-${String(_today.getMonth() + 1).padStart(2, '0')}-${String(_today.getDate()).padStart(2, '0')}`;

const calendarJson = JSON.stringify({
  rates: data.rates,
  blocked: data.blocked,
  minStay: data.minStay,
  currency: data.currency,
  todayIso,
  rentalSlug: 'apartamento-mar-azul',
  rentalId: '671442',
  visibleMonths,
  localeCode,
});

const i18nJson = JSON.stringify({
  checkInPrefix: t.calendarPicker.checkInPrefix,
  checkInPickout: t.calendarPicker.checkInPickout,
  totalLabelTemplate: t.calendarPicker.totalLabelTemplate,
  minStayWarning: t.calendarPicker.minStayWarning,
  minNights: t.calendarPicker.minNights,
  minNightsPlural: t.calendarPicker.minNightsPlural,
  nightSingular: t.calendarPicker.nightSingular,
  nightsLabel: t.calendarPicker.nightsLabel,
});

const whatsappHref = WHATSAPP.number
  ? `https://wa.me/${WHATSAPP.number}?text=${encodeURIComponent(WHATSAPP.defaultMessage)}`
  : '#whatsapp';

const isoFor = (year: number, month: number, day: number) =>
  `${year}-${String(month + 1).padStart(2, '0')}-${String(day).padStart(2, '0')}`;

const showNav = monthsToRender.length > visibleMonths;
const resolvedCtaLabel = ctaLabel ?? t.common.continueToBooking;
const pickMetaText = data.isLive ? interp(t.calendarPicker.pickMetaLive, { minStay: data.minStay }) : interp(t.calendarPicker.pickMeta, { minStay: data.minStay });
---

<div class="cp" data-calendar-picker data-config={calendarJson} data-i18n={i18nJson} data-visible={visibleMonths}>
  {showNav && (
    <div class="cp-nav">
      <button type="button" class="cp-nav-btn" data-cp-prev aria-label={t.calendarPicker.navAriaPrevious} disabled>
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
        <span>{t.calendarPicker.navPrevious}</span>
      </button>
      <span class="cp-nav-range" data-cp-range aria-live="polite"></span>
      <button type="button" class="cp-nav-btn" data-cp-next aria-label={t.calendarPicker.navAriaNext}>
        <span>{t.calendarPicker.navNext}</span>
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>
    </div>
  )}

  <div class="cp-cal" data-cp-cal>
    {monthsToRender.map((m, monthIdx) => (
      <div
        class="cp-month"
        data-month-index={monthIdx}
        hidden={monthIdx >= visibleMonths}
      >
        <p class="cp-month-name">{m.monthName}</p>
        <div class="cp-dow" aria-hidden="true">
          <span>M</span><span>T</span><span>W</span><span>T</span><span>F</span><span>S</span><span>S</span>
        </div>
        <div class="cp-grid" role="grid">
          {Array.from({ length: m.firstWeekdayMondayBased }).map(() => (
            <span class="cp-d cp-d-empty" aria-hidden="true"></span>
          ))}
          {Array.from({ length: m.daysInMonth }).map((_, i) => {
            const day = i + 1;
            const iso = isoFor(m.year, m.month, day);
            const blocked = data.blocked.includes(iso);
            const past = iso < todayIso;
            const today = iso === todayIso;
            const price = data.rates[iso];
            return (
              <button
                type="button"
                class:list={[
                  'cp-d',
                  { 'is-blocked': blocked, 'is-past': past, 'is-today': today, 'is-disabled': blocked || past },
                ]}
                data-date={iso}
                data-price={price ?? ''}
                disabled={blocked || past}
                aria-label={`${m.monthName} ${day}${blocked ? ' (unavailable)' : price ? ` €${price}` : ''}`}
                aria-disabled={blocked || past}
              >
                <span class="cp-d-num">{day}</span>
                {price && !blocked && !past && (
                  <span class="cp-d-price" aria-hidden="true">€{price}</span>
                )}
              </button>
            );
          })}
        </div>
      </div>
    ))}
  </div>

  <div class="cp-footer">
    <div class="cp-summary">
      <div class="cp-summary-default" data-summary-default>
        <p class="cp-summary-headline">{t.calendarPicker.pickHeadline}</p>
        <p class="cp-summary-meta">{pickMetaText}</p>
      </div>
      <div class="cp-summary-active" data-summary-active hidden>
        <p class="cp-summary-headline" data-summary-active-headline></p>
        <p class="cp-summary-meta" data-summary-active-meta>
          <span data-summary-total></span>
          <span class="cp-summary-meta-sep" aria-hidden="true"> · </span>
          <button type="button" class="cp-clear" data-clear>{t.calendarPicker.clearDates}</button>
        </p>
      </div>
      <div class="cp-summary-error" data-summary-error hidden>
        <p class="cp-summary-headline cp-error">{t.calendarPicker.blockedError}</p>
        <p class="cp-summary-meta">
          <button type="button" class="cp-clear" data-clear>{t.calendarPicker.clearDates}</button>
        </p>
      </div>
    </div>

    <div class="cp-cta">
      <a class="btn btn-primary cp-book" data-book href="#" hidden>{resolvedCtaLabel}</a>
      <a
        class="btn btn-ghost"
        href={whatsappHref}
        target={WHATSAPP.number ? '_blank' : undefined}
        rel={WHATSAPP.number ? 'noopener noreferrer' : undefined}
      >
        <span>{t.common.whatsappFallback}</span>
        <span class="micro">{t.common.whatsappMicro}</span>
      </a>
    </div>
  </div>
</div>

<style>
  .cp {
    margin-top: 24px;
    padding: 24px;
    background: #F1EEE7;
    border: 1px solid #E5DED1;
    border-radius: 14px;
  }
  .cp-cal {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px;
  }
  @media (max-width: 720px) {
    .cp { padding: 16px; }
    .cp-cal { grid-template-columns: 1fr; gap: 20px; }
  }

  /* ----- Nav ----- */
  .cp-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 20px;
    padding-bottom: 16px;
    border-bottom: 1px solid #D6CFC0;
  }
  .cp-nav-range {
    font: 600 14px/1 var(--font-body);
    color: var(--color-deep-navy);
    letter-spacing: 0.04em;
  }
  .cp-nav-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: transparent;
    border: 1px solid #D6CFC0;
    border-radius: 8px;
    padding: 8px 14px;
    font: 500 13px/1 var(--font-body);
    color: var(--color-atlantic-blue);
    cursor: pointer;
    min-height: 36px;
    transition: background 160ms ease-out, border-color 160ms ease-out;
  }
  .cp-nav-btn:hover:not(:disabled) {
    background: var(--color-warm-white);
    border-color: var(--color-atlantic-blue);
  }
  .cp-nav-btn:disabled {
    color: var(--color-slate-grey);
    border-color: #E5DED1;
    cursor: not-allowed;
    opacity: 0.5;
  }

  .cp-month { display: flex; flex-direction: column; }
  .cp-month[hidden] { display: none; }
  .cp-month-name {
    font: 600 15px/1 var(--font-body);
    color: var(--color-deep-navy);
    margin: 0 0 14px;
    letter-spacing: 0.04em;
  }
  .cp-dow {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 4px;
    margin-bottom: 6px;
  }
  .cp-dow span {
    font: 600 11px/1 var(--font-body);
    letter-spacing: 0.04em;
    color: var(--color-slate-grey);
    text-align: center;
    padding: 4px 0;
  }
  .cp-grid {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 4px;
  }
  .cp-d {
    aspect-ratio: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1px;
    font: 400 14px/1 var(--font-body);
    color: var(--color-deep-navy);
    background: transparent;
    border: 0;
    border-radius: 4px;
    padding: 0;
    cursor: pointer;
    transition: background 120ms ease-out, color 120ms ease-out;
    position: relative;
  }
  .cp-d:hover:not(.is-disabled):not(.is-start):not(.is-end) {
    background: var(--color-warm-white);
    box-shadow: inset 0 0 0 1.5px var(--color-atlantic-blue);
  }
  .cp-d.is-disabled, .cp-d:disabled { cursor: not-allowed; }
  .cp-d.is-blocked {
    color: var(--color-slate-grey);
    text-decoration: line-through;
    opacity: 0.45;
  }
  .cp-d.is-past {
    color: var(--color-slate-grey);
    opacity: 0.3;
  }
  .cp-d.is-today {
    box-shadow: inset 0 0 0 1px var(--color-atlantic-blue);
  }
  .cp-d.is-sel {
    background: var(--color-seafoam);
    color: var(--color-deep-navy);
  }
  .cp-d.is-start, .cp-d.is-end {
    background: var(--color-atlantic-blue);
    color: var(--color-warm-white);
    font-weight: 600;
  }
  .cp-d-empty { pointer-events: none; }
  .cp-d-num { font-size: inherit; line-height: 1; }
  .cp-d-price {
    font-size: 9px;
    line-height: 1;
    color: var(--color-slate-grey);
    opacity: 0.85;
    font-weight: 500;
  }
  .cp-d.is-sel .cp-d-price,
  .cp-d.is-start .cp-d-price,
  .cp-d.is-end .cp-d-price {
    color: inherit;
    opacity: 0.9;
  }

  .cp-footer {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 32px;
    align-items: center;
    margin-top: 28px;
    padding-top: 20px;
    border-top: 1px solid #D6CFC0;
  }
  @media (max-width: 720px) {
    .cp-footer { grid-template-columns: 1fr; gap: 16px; }
  }

  .cp-summary-headline {
    font: 600 17px/1.3 var(--font-body);
    color: var(--color-deep-navy);
    margin: 0 0 6px;
  }
  .cp-summary-meta {
    font: 400 14px/1.4 var(--font-body);
    color: var(--color-slate-grey);
    margin: 0;
  }
  .cp-error { color: var(--color-error-red, #B0392A); }
  .cp-clear {
    background: transparent;
    border: 0;
    padding: 0;
    cursor: pointer;
    color: var(--color-atlantic-blue);
    font: 500 14px/1 var(--font-body);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .cp-clear:hover { text-decoration-color: currentColor; }

  .cp-cta {
    display: flex;
    flex-direction: column;
    gap: 10px;
    align-items: stretch;
  }
  .cp-book[hidden] { display: none; }
  .cp-book { justify-content: center; }
</style>

<script>
  type Cfg = {
    rates: Record<string, number>;
    blocked: string[];
    minStay: number;
    currency: string;
    todayIso: string;
    rentalSlug: string;
    rentalId: string;
    visibleMonths: number;
    localeCode: string;
  };

  type I18n = {
    checkInPrefix: string;
    checkInPickout: string;
    totalLabelTemplate: string;
    minStayWarning: string;
    minNights: string;
    minNightsPlural: string;
    nightSingular: string;
    nightsLabel: string;
  };

  function interp(template: string, values: Record<string, string | number>): string {
    return template.replace(/\{(\w+)\}/g, (_, key) => String(values[key] ?? `{${key}}`));
  }

  function fmtDate(iso: string, localeCode: string): string {
    const [y, m, d] = iso.split('-').map(Number);
    return new Date(y, m - 1, d).toLocaleDateString(localeCode, { day: 'numeric', month: 'short' });
  }
  function nightsBetween(from: string, to: string): number {
    const [ay, am, ad] = from.split('-').map(Number);
    const [by, bm, bd] = to.split('-').map(Number);
    const a = Date.UTC(ay, am - 1, ad);
    const b = Date.UTC(by, bm - 1, bd);
    return Math.round((b - a) / (24 * 3600 * 1000));
  }
  function rangeBlocked(blocked: Set<string>, from: string, to: string): boolean {
    const [sy, sm, sd] = from.split('-').map(Number);
    const [ey, em, ed] = to.split('-').map(Number);
    const start = new Date(Date.UTC(sy, sm - 1, sd));
    const end = new Date(Date.UTC(ey, em - 1, ed));
    for (let d = new Date(start); d < end; d.setUTCDate(d.getUTCDate() + 1)) {
      if (blocked.has(d.toISOString().slice(0, 10))) return true;
    }
    return false;
  }
  function rangeTotal(rates: Record<string, number>, from: string, to: string): number {
    const [sy, sm, sd] = from.split('-').map(Number);
    const [ey, em, ed] = to.split('-').map(Number);
    const start = new Date(Date.UTC(sy, sm - 1, sd));
    const end = new Date(Date.UTC(ey, em - 1, ed));
    let total = 0;
    for (let d = new Date(start); d < end; d.setUTCDate(d.getUTCDate() + 1)) {
      total += rates[d.toISOString().slice(0, 10)] ?? 0;
    }
    return total;
  }
  function buildCheckout(cfg: Cfg, from: string, to: string): string {
    const params = new URLSearchParams({
      arrival: from,
      departure: to,
      adults: '2',
      children: '0',
      infants: '0',
    });
    return `https://checkout.lodgify.com/${cfg.rentalSlug}/en/?${params.toString()}#/${cfg.rentalId}`;
  }

  document.querySelectorAll<HTMLDivElement>('[data-calendar-picker]').forEach((root) => {
    const cfg: Cfg = JSON.parse(root.getAttribute('data-config') || '{}');
    const i18n: I18n = JSON.parse(root.getAttribute('data-i18n') || '{}');
    const localeCode = cfg.localeCode || 'en-GB';
    const blockedSet = new Set(cfg.blocked);
    const cells = Array.from(root.querySelectorAll<HTMLButtonElement>('.cp-d[data-date]'));
    const months = Array.from(root.querySelectorAll<HTMLDivElement>('.cp-month'));
    const summaryDefault = root.querySelector<HTMLDivElement>('[data-summary-default]');
    const summaryActive = root.querySelector<HTMLDivElement>('[data-summary-active]');
    const summaryActiveHeadline = root.querySelector<HTMLParagraphElement>('[data-summary-active-headline]');
    const summaryError = root.querySelector<HTMLDivElement>('[data-summary-error]');
    const summaryTotal = root.querySelector<HTMLSpanElement>('[data-summary-total]');
    const bookBtn = root.querySelector<HTMLAnchorElement>('[data-book]');
    const clearBtns = root.querySelectorAll<HTMLButtonElement>('[data-clear]');
    const prevBtn = root.querySelector<HTMLButtonElement>('[data-cp-prev]');
    const nextBtn = root.querySelector<HTMLButtonElement>('[data-cp-next]');
    const rangeLabel = root.querySelector<HTMLSpanElement>('[data-cp-range]');

    let checkIn: string | null = null;
    let checkOut: string | null = null;
    let viewStart = 0;
    const visible = cfg.visibleMonths || 2;

    function renderMonths() {
      months.forEach((m, i) => {
        m.hidden = i < viewStart || i >= viewStart + visible;
      });
      if (prevBtn) prevBtn.disabled = viewStart === 0;
      if (nextBtn) nextBtn.disabled = viewStart + visible >= months.length;
      if (rangeLabel) {
        const firstName = months[viewStart]?.querySelector<HTMLParagraphElement>('.cp-month-name')?.textContent;
        const lastIdx = Math.min(viewStart + visible - 1, months.length - 1);
        const lastName = months[lastIdx]?.querySelector<HTMLParagraphElement>('.cp-month-name')?.textContent;
        rangeLabel.textContent = firstName === lastName ? (firstName || '') : `${firstName} – ${lastName}`;
      }
    }

    function renderSelection() {
      cells.forEach((cell) => cell.classList.remove('is-start', 'is-end', 'is-sel'));
      summaryDefault?.toggleAttribute('hidden', !!checkIn);
      summaryActive?.toggleAttribute('hidden', !checkIn || !checkOut);
      summaryError?.toggleAttribute('hidden', true);
      bookBtn?.toggleAttribute('hidden', !checkIn || !checkOut);

      if (checkIn) {
        cells.find((c) => c.dataset.date === checkIn)?.classList.add('is-start');
      }
      if (checkOut && checkIn) {
        cells.find((c) => c.dataset.date === checkOut)?.classList.add('is-end');
        cells.forEach((cell) => {
          const d = cell.dataset.date;
          if (d && d > checkIn! && d < checkOut!) cell.classList.add('is-sel');
        });

        const nights = nightsBetween(checkIn, checkOut);
        if (rangeBlocked(blockedSet, checkIn, checkOut)) {
          summaryActive?.toggleAttribute('hidden', true);
          summaryError?.toggleAttribute('hidden', false);
          bookBtn?.toggleAttribute('hidden', true);
          return;
        }
        if (nights < cfg.minStay) {
          if (summaryActiveHeadline) {
            const tmpl = nights === 1 ? i18n.minNights : i18n.minNightsPlural;
            summaryActiveHeadline.textContent = interp(tmpl, { nights, minStay: cfg.minStay });
          }
          if (summaryTotal) summaryTotal.textContent = interp(i18n.minStayWarning, { minStay: cfg.minStay });
          bookBtn?.toggleAttribute('hidden', true);
          return;
        }
        const total = rangeTotal(cfg.rates, checkIn, checkOut);
        if (summaryActiveHeadline) {
          const noun = nights === 1 ? i18n.nightSingular : i18n.nightsLabel;
          summaryActiveHeadline.textContent = `${nights} ${noun} · ${fmtDate(checkIn, localeCode)} → ${fmtDate(checkOut, localeCode)}`;
        }
        if (summaryTotal) {
          const ppn = nights > 0 ? Math.round(total / nights) : 0;
          summaryTotal.textContent = interp(i18n.totalLabelTemplate, {
            total: total.toLocaleString(localeCode),
            ppn,
          });
        }
        if (bookBtn) bookBtn.href = buildCheckout(cfg, checkIn, checkOut);
      } else if (checkIn && !checkOut) {
        if (summaryActiveHeadline) {
          summaryActiveHeadline.textContent = `${i18n.checkInPrefix} ${fmtDate(checkIn, localeCode)}`;
        }
        if (summaryTotal) summaryTotal.textContent = interp(i18n.checkInPickout, { minStay: cfg.minStay });
        summaryActive?.toggleAttribute('hidden', false);
        summaryDefault?.toggleAttribute('hidden', true);
        bookBtn?.toggleAttribute('hidden', true);
      }
    }

    cells.forEach((cell) => {
      cell.addEventListener('click', () => {
        if (cell.classList.contains('is-disabled') || cell.disabled) return;
        const d = cell.dataset.date;
        if (!d) return;
        if (!checkIn) { checkIn = d; checkOut = null; }
        else if (checkIn && !checkOut) {
          if (d > checkIn) checkOut = d;
          else { checkIn = d; checkOut = null; }
        }
        else { checkIn = d; checkOut = null; }
        renderSelection();
      });
    });

    clearBtns.forEach((btn) => btn.addEventListener('click', () => {
      checkIn = null; checkOut = null; renderSelection();
    }));

    prevBtn?.addEventListener('click', () => {
      viewStart = Math.max(0, viewStart - visible);
      renderMonths();
    });
    nextBtn?.addEventListener('click', () => {
      viewStart = Math.min(Math.max(0, months.length - visible), viewStart + visible);
      renderMonths();
    });

    renderMonths();
    renderSelection();
  });
</script>
