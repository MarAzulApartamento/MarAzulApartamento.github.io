---
interface Props {
  priceFrom?: number;
}

const { priceFrom = 100 } = Astro.props;
---

<div class="sticky-cta" data-sticky-cta role="complementary">
  <div class="sticky-cta-inner">
    <div class="sticky-info">
      <span class="sticky-price">From €{priceFrom} per night</span>
      <span class="sticky-meta">Best rate available, every time.</span>
    </div>
    <a class="btn btn-primary" href="/book">Book direct</a>
  </div>
</div>

<style>
  .sticky-cta {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 40;
    transform: translateY(100%);
    transition: transform 280ms cubic-bezier(0.32, 0.72, 0, 1);
    background: rgba(248, 246, 241, 0.95);
    backdrop-filter: blur(12px);
    border-top: 1px solid #E5DED1;
    box-shadow: 0 -4px 14px rgba(29, 38, 48, 0.10);
  }
  .sticky-cta.is-visible {
    transform: translateY(0);
  }
  .sticky-cta-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    max-width: 1200px;
    margin: 0 auto;
    padding: 14px 48px;
    gap: 16px;
  }
  .sticky-info {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .sticky-price {
    font: 700 17px/1 var(--font-display);
    color: var(--color-deep-navy);
    letter-spacing: -0.01em;
  }
  .sticky-meta {
    font: 400 13px/1 var(--font-body);
    color: var(--color-slate-grey);
  }
  @media (max-width: 720px) {
    .sticky-cta-inner { padding: 12px 16px; }
    .sticky-meta { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .sticky-cta { transition: none; }
  }
</style>

<script>
  const cta = document.querySelector<HTMLDivElement>('[data-sticky-cta]');
  const footer = document.querySelector<HTMLElement>('footer');

  if (cta) {
    let heroPassed = false;
    let footerVisible = false;

    function updateVisibility() {
      cta!.classList.toggle('is-visible', heroPassed && !footerVisible);
    }

    // Show after scrolling past 600px (past hero)
    function onScroll() {
      heroPassed = window.scrollY > 600;
      updateVisibility();
    }
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });

    // Hide when footer enters viewport
    if (footer) {
      const obs = new IntersectionObserver(
        ([entry]) => {
          footerVisible = entry.isIntersecting;
          updateVisibility();
        },
        { threshold: 0 }
      );
      obs.observe(footer);
    }
  }
</script>
