---
import { getStrings } from '../lib/i18n';
const t = getStrings(Astro.currentLocale);
---

<section class="section section-tint">
  <div class="container about">
    <div class="about-photo" aria-hidden="true"></div>
    <div class="about-text">
      <p class="eyebrow">{t.about.eyebrow}</p>
      <h2 class="h2">{t.about.title}</h2>
      <p>{t.about.body}</p>
      <p class="muted">{t.about.hostedBy} {t.common.whatsappMicro}.</p>
    </div>
  </div>
</section>

<style>
  .about {
    display: grid;
    grid-template-columns: 5fr 7fr;
    gap: 48px;
    align-items: center;
  }
  .about-photo {
    aspect-ratio: 4/5;
    background: url('/photos/owner_picture.jpg') center/cover;
    border-radius: 14px;
  }
  @media (max-width: 900px) {
    .about { grid-template-columns: 1fr; gap: 24px; }
    .about-photo { aspect-ratio: 5/4; }
  }
</style>
