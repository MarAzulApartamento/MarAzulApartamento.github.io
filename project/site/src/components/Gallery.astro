---
import { getStrings } from '../lib/i18n';

interface Tile {
  src: string;
  cap: string;
  span?: string;
}

const t = getStrings(Astro.currentLocale);
const c = t.gallery.captions;

const tiles: Tile[] = [
  { src: '/photos/marazul-01.jpg', cap: c['marazul-01'], span: 'wide tall' },
  { src: '/photos/marazul-02.jpg', cap: c['marazul-02'] },
  { src: '/photos/marazul-08.jpg', cap: c['marazul-08'] },
  { src: '/photos/marazul-04.jpg', cap: c['marazul-04'] },
  { src: '/photos/marazul-05.jpg', cap: c['marazul-05'] },
  { src: '/photos/marazul-09.jpg', cap: c['marazul-09'] },
  { src: '/photos/marazul-11.jpg', cap: c['marazul-11'] },
  { src: '/photos/marazul-07.jpg', cap: c['marazul-07'] },
  { src: '/photos/marazul-03.jpg', cap: c['marazul-03'] },
  { src: '/photos/marazul-10.jpg', cap: c['marazul-10'] },
  { src: '/photos/marazul-06.jpg', cap: c['marazul-06'] },
];
---

<section class="section">
  <div class="container">
    <p class="eyebrow">{t.gallery.eyebrow}</p>
    <h2 class="h2">{t.gallery.title}</h2>
    <div class="mosaic" data-gallery>
      {tiles.map((tile, i) => (
        <button
          class={`tile${tile.span ? ` ${tile.span}` : ''}`}
          data-tile-index={i}
          data-src={tile.src}
          data-cap={tile.cap}
          aria-label={`${t.gallery.openLabel} ${tile.cap}`}
          type="button"
        >
          <img
            src={tile.src}
            alt={tile.cap}
            loading={i === 0 ? 'eager' : 'lazy'}
            decoding="async"
          />
          <span class="cap">{tile.cap}</span>
        </button>
      ))}
    </div>
  </div>
</section>

<!-- Lightbox markup, hidden by default -->
<div class="lightbox" data-lightbox role="dialog" aria-modal="true" aria-label="Photo viewer" hidden>
  <div class="lightbox-inner" data-lightbox-inner>
    <img data-lightbox-img alt="" />
    <p class="lightbox-cap" data-lightbox-cap></p>
  </div>
  <button class="lightbox-nav lightbox-prev" data-lightbox-prev aria-label="Previous photo" type="button">
    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <polyline points="15 18 9 12 15 6"></polyline>
    </svg>
  </button>
  <button class="lightbox-nav lightbox-next" data-lightbox-next aria-label="Next photo" type="button">
    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <polyline points="9 18 15 12 9 6"></polyline>
    </svg>
  </button>
  <button class="lightbox-close" data-lightbox-close aria-label="Close" type="button">
    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
      <path d="M6 6l12 12M18 6L6 18"></path>
    </svg>
  </button>
</div>

<style>
  /* Mosaic */
  .mosaic {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-auto-rows: 180px;
    gap: 10px;
    margin-top: 24px;
  }
  .tile {
    background: #ddd;
    border-radius: 8px;
    border: 0;
    padding: 0;
    position: relative;
    cursor: pointer;
    overflow: hidden;
    transition: transform 220ms ease-out, filter 220ms ease-out;
  }
  .tile img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    transition: filter 220ms ease-out;
  }
  .tile:hover img { filter: brightness(1.04); }
  .tile.wide { grid-column: span 2; }
  .tile.tall { grid-row: span 2; }
  .tile .cap {
    position: absolute;
    left: 10px;
    bottom: 10px;
    font: 500 12px/1 var(--font-body);
    color: var(--color-warm-white);
    background: rgba(29, 38, 48, 0.55);
    padding: 6px 9px;
    border-radius: 4px;
    opacity: 0;
    transition: opacity 220ms ease-out;
  }
  .tile:hover .cap, .tile:focus-visible .cap { opacity: 1; }
  @media (max-width: 720px) {
    .mosaic { grid-template-columns: repeat(2, 1fr); grid-auto-rows: 140px; }
    .tile.tall { grid-row: span 1; }
  }

  /* Lightbox */
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 50;
    background: rgba(29, 38, 48, 0.82);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 32px;
    animation: fadein 220ms ease-out;
  }
  .lightbox[hidden] { display: none; }
  @keyframes fadein { from { opacity: 0; } to { opacity: 1; } }
  .lightbox-inner {
    max-width: 1100px;
    max-height: 86vh;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
    animation: scalein 220ms ease-out;
  }
  @keyframes scalein {
    from { opacity: 0; transform: scale(0.96); }
    to { opacity: 1; transform: scale(1); }
  }
  .lightbox-inner img {
    max-width: 100%;
    max-height: 80vh;
    border-radius: 8px;
    display: block;
  }
  .lightbox-cap {
    color: var(--color-warm-white);
    font: 500 14px/1.4 var(--font-body);
    margin: 0;
    text-align: left;
    align-self: flex-start;
  }
  .lightbox-nav,
  .lightbox-close {
    position: absolute;
    width: 48px;
    height: 48px;
    background: rgba(248, 246, 241, 0.12);
    color: var(--color-warm-white);
    border: 0;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background 160ms ease-out;
  }
  .lightbox-nav:hover,
  .lightbox-close:hover { background: rgba(248, 246, 241, 0.22); }
  .lightbox-nav { top: 50%; transform: translateY(-50%); }
  .lightbox-prev { left: 24px; }
  .lightbox-next { right: 24px; }
  .lightbox-close { top: 24px; right: 24px; width: 44px; height: 44px; }
  .lightbox-nav[hidden],
  .lightbox-close[hidden] { display: none; }
  @media (max-width: 720px) {
    .lightbox { padding: 16px; }
    .lightbox-nav { width: 44px; height: 44px; }
    .lightbox-prev { left: 12px; }
    .lightbox-next { right: 12px; }
    .lightbox-close { top: 12px; right: 12px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .lightbox, .lightbox-inner { animation: none; }
  }
</style>

<script>
  type Tile = { src: string; cap: string };
  const tiles: Tile[] = Array.from(document.querySelectorAll('[data-tile-index]'))
    .sort((a, b) => Number(a.getAttribute('data-tile-index')) - Number(b.getAttribute('data-tile-index')))
    .map((el) => ({ src: el.getAttribute('data-src') || '', cap: el.getAttribute('data-cap') || '' }));

  const lightbox = document.querySelector<HTMLDivElement>('[data-lightbox]');
  const imgEl = document.querySelector<HTMLImageElement>('[data-lightbox-img]');
  const capEl = document.querySelector<HTMLParagraphElement>('[data-lightbox-cap]');
  const prevBtn = document.querySelector<HTMLButtonElement>('[data-lightbox-prev]');
  const nextBtn = document.querySelector<HTMLButtonElement>('[data-lightbox-next]');
  const closeBtn = document.querySelector<HTMLButtonElement>('[data-lightbox-close]');

  let currentIndex = -1;
  let touchStartX: number | null = null;

  function openLightbox(idx: number) {
    if (!lightbox || !imgEl || !capEl) return;
    currentIndex = idx;
    const t = tiles[idx];
    imgEl.src = t.src;
    imgEl.alt = t.cap;
    capEl.textContent = t.cap;
    lightbox.hidden = false;
    document.body.style.overflow = 'hidden';
    updateNav();
  }

  function closeLightbox() {
    if (!lightbox) return;
    lightbox.hidden = true;
    document.body.style.overflow = '';
    currentIndex = -1;
  }

  function navigate(delta: number) {
    const next = currentIndex + delta;
    if (next < 0 || next >= tiles.length) return;
    openLightbox(next);
  }

  function updateNav() {
    if (prevBtn) prevBtn.hidden = currentIndex <= 0;
    if (nextBtn) nextBtn.hidden = currentIndex >= tiles.length - 1;
  }

  // Tile clicks
  document.querySelectorAll<HTMLButtonElement>('[data-tile-index]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const idx = Number(btn.getAttribute('data-tile-index'));
      openLightbox(idx);
    });
  });

  prevBtn?.addEventListener('click', (e) => { e.stopPropagation(); navigate(-1); });
  nextBtn?.addEventListener('click', (e) => { e.stopPropagation(); navigate(1); });
  closeBtn?.addEventListener('click', closeLightbox);

  // Backdrop click closes; click on image/inner does not
  lightbox?.addEventListener('click', (e) => {
    if (e.target === lightbox) closeLightbox();
  });

  // Keyboard
  document.addEventListener('keydown', (e) => {
    if (currentIndex < 0) return;
    if (e.key === 'Escape') closeLightbox();
    else if (e.key === 'ArrowLeft') navigate(-1);
    else if (e.key === 'ArrowRight') navigate(1);
  });

  // Mobile swipe
  lightbox?.addEventListener('touchstart', (e) => {
    touchStartX = e.touches[0].clientX;
  }, { passive: true });
  lightbox?.addEventListener('touchend', (e) => {
    if (touchStartX == null) return;
    const dx = e.changedTouches[0].clientX - touchStartX;
    touchStartX = null;
    if (Math.abs(dx) < 50) return;
    if (dx > 0) navigate(-1);
    else navigate(1);
  });
</script>
