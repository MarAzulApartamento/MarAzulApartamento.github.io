---
import CalendarPicker from './CalendarPicker.astro';
import type { CalendarData } from '../lib/lodgify';

interface Props {
  data: CalendarData;
}

const { data } = Astro.props;
---

<section class="section" id="availability">
  <div class="container">
    <p class="eyebrow">Your dates</p>
    <h2 class="h2">Pick your dates.</h2>
    <p class="lede">
      Real-time availability. Prices update from €{Object.values(data.rates).length > 0 ? Math.min(...Object.values(data.rates)) : 100} per night. {data.minStay}-night minimum.
    </p>

    <CalendarPicker data={data} visibleMonths={2} ctaLabel="Continue to booking →" />
  </div>
</section>
