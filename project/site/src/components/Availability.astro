---
import { WHATSAPP } from '../lib/config';

interface Props {
  priceFrom?: number;
  minStay?: number;
}

const { priceFrom = 100, minStay = 3 } = Astro.props;

// Visual-only calendar for the design preview. Sprint 2 follow-up wires
// real availability from Lodgify /v2/availability.
const monthA = { name: 'June 2026', days: 30, blocked: [3, 4, 5, 24, 25, 26, 27], selected: { start: 14, end: 20 } };
const monthB = { name: 'July 2026', days: 31, blocked: [10, 11, 12, 13, 14, 22, 23], selected: null as { start: number; end: number } | null };

const whatsappHref = WHATSAPP.number
  ? `https://wa.me/${WHATSAPP.number}?text=${encodeURIComponent(WHATSAPP.defaultMessage)}`
  : '#whatsapp';
---

<section class="section" id="availability">
  <div class="container">
    <p class="eyebrow">Your dates</p>
    <h2 class="h2">Pick your dates.</h2>
    <p class="lede">Real-time availability. Prices update from €{priceFrom} per night. {minStay}-night minimum.</p>
    <div class="avail-cal">
      {[monthA, monthB].map((m) => (
        <div class="cal-month">
          <p class="cal-name">{m.name}</p>
          <div class="cal-grid">
            {Array.from({ length: m.days }).map((_, i) => {
              const d = i + 1;
              const isBlocked = m.blocked.includes(d);
              const sel = m.selected;
              const isStart = sel?.start === d;
              const isEnd = sel?.end === d;
              const isSel = sel ? d > sel.start && d < sel.end : false;
              const cls = ['cal-d'];
              if (isBlocked) cls.push('is-blocked');
              if (isStart) cls.push('is-start');
              if (isEnd) cls.push('is-end');
              if (isSel) cls.push('is-sel');
              return <span class={cls.join(' ')}>{d}</span>;
            })}
          </div>
        </div>
      ))}
    </div>
    <div class="avail-cta">
      <a class="btn btn-primary" href="/book">Continue to booking →</a>
      <a class="btn btn-ghost" href={whatsappHref} target={WHATSAPP.number ? '_blank' : undefined} rel={WHATSAPP.number ? 'noopener noreferrer' : undefined}>
        <span>Or message us on WhatsApp</span>
        <span class="micro">{WHATSAPP.responseTime}</span>
      </a>
    </div>
  </div>
</section>

<style>
  .avail-cal {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px;
    margin-top: 24px;
    padding: 24px;
    background: #F1EEE7;
    border: 1px solid #E5DED1;
    border-radius: 14px;
  }
  .cal-name {
    font: 600 15px/1 var(--font-body);
    color: var(--color-deep-navy);
    margin: 0 0 14px;
    letter-spacing: 0.04em;
  }
  .cal-grid {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 4px;
  }
  .cal-d {
    aspect-ratio: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    font: 400 14px/1 var(--font-body);
    color: var(--color-deep-navy);
    border-radius: 4px;
  }
  .cal-d.is-blocked {
    color: var(--color-slate-grey);
    text-decoration: line-through;
    opacity: 0.45;
  }
  .cal-d.is-sel {
    background: var(--color-seafoam);
  }
  .cal-d.is-start, .cal-d.is-end {
    background: var(--color-atlantic-blue);
    color: var(--color-warm-white);
    font-weight: 600;
  }
  .avail-cta {
    display: flex;
    gap: 24px;
    align-items: center;
    flex-wrap: wrap;
    margin-top: 28px;
  }
  @media (max-width: 720px) {
    .avail-cal { grid-template-columns: 1fr; gap: 16px; padding: 16px; }
    .avail-cta { gap: 16px; }
  }
</style>
