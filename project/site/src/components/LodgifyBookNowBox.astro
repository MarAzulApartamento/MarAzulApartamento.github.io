---
/**
 * Lodgify Book Now Box widget — embedded date picker + guest count +
 * inline price + "Book direct" button. Click sends the user to
 * Lodgify-hosted checkout in a new tab (data-new-tab="true"),
 * preserving our domain for the comparison stage.
 *
 * Lodgify support confirmed (2026-05-07): no fully-inline-checkout
 * widget exists on any plan, including Ultimate. This is the maximum
 * brand-cohesive booking flow Lodgify supports.
 *
 * Branded via aggressive CSS variable overrides (Atlantic Blue,
 * Seafoam, Warm White, Deep Navy). Wrapped in a "booking shell" card
 * with Lodgify trust badge to set the tone.
 */
const RENTAL_ID = '671442';
const WEBSITE_ID = '581042';
const SLUG = 'apartamento-mar-azul';

interface Props {
  /** Optional secure-checkout sub-line. */
  showShell?: boolean;
}
const { showShell = true } = Astro.props;
---

{showShell ? (
  <div class="lodgify-shell">
    <div class="lodgify-shell-head">
      <span class="lodgify-shell-eye">Secure direct booking</span>
      <span class="lodgify-shell-meta">Powered by Lodgify · Stripe payments · we may answer within 12 hours</span>
    </div>
    <div class="lodgify-shell-body">
      <div
        id="lodgify-book-now-box"
        data-rental-id={RENTAL_ID}
        data-website-id={WEBSITE_ID}
        data-slug={SLUG}
        data-language-code="en"
        data-currency-code="EUR"
        data-new-tab="true"
        data-version="stable"
        data-has-guests-breakdown
        data-check-in-label="Check-in"
        data-check-out-label="Check-out"
        data-guests-label="Guests"
        data-guests-singular-label="{{NumberOfGuests}} guest"
        data-guests-plural-label="{{NumberOfGuests}} guests"
        data-location-input-label="Location"
        data-total-price-label="Total"
        data-select-dates-to-see-price-label="Pick your dates to see the total"
        data-minimum-price-per-night-first-label="From"
        data-minimum-price-per-night-second-label="per night"
        data-book-button-label="Book direct"
        data-guests-breakdown-label="Guests"
        data-adults-label='{"one":"adult","other":"adults"}'
        data-adults-description="Ages {minAge} or above"
        data-children-label='{"one":"child","other":"children"}'
        data-children-description="Ages {minAge}-{maxAge}"
        data-children-not-allowed-label="Not suitable for children"
        data-infants-label='{"one":"infant","other":"infants"}'
        data-infants-description="Under {maxAge}"
        data-infants-not-allowed-label="Not suitable for infants"
        data-pets-label='{"one":"pet","other":"pets"}'
        data-pets-not-allowed-label="Not allowed"
        data-done-label="Done"
      ></div>
    </div>
  </div>
) : (
  <div
    id="lodgify-book-now-box"
    data-rental-id={RENTAL_ID}
    data-website-id={WEBSITE_ID}
    data-slug={SLUG}
    data-language-code="en"
    data-currency-code="EUR"
    data-new-tab="true"
    data-version="stable"
    data-has-guests-breakdown
  ></div>
)}

<script src="https://app.lodgify.com/book-now-box/stable/renderBookNowBox.js" is:inline defer></script>

<style is:global>
  /* ============================================================
     Lodgify Book Now Box — brand override
     The widget reads these :root variables. Without overrides it
     defaults to gold (#fac600). Overrides scoped to :root because
     Lodgify renders into shadow-style host without scope inheritance
     for some elements.
     ============================================================ */
  :root {
    --ldg-bnb-background: #FFFFFF;
    --ldg-bnb-border-radius: 14px;
    --ldg-bnb-box-shadow: none;
    --ldg-bnb-padding: 22px;
    --ldg-bnb-input-background: #FFFFFF;
    --ldg-bnb-button-border-radius: 8px;

    --ldg-bnb-color-primary: #1E5B73;
    --ldg-bnb-color-primary-lighter: #CFE3DE;
    --ldg-bnb-color-primary-darker: #143E4E;
    --ldg-bnb-color-primary-contrast: #F8F6F1;

    --ldg-component-calendar-cell-selection-bg-color: #1E5B73;
    --ldg-component-calendar-cell-selection-color: #F8F6F1;
    --ldg-component-calendar-cell-selected-bg-color: #CFE3DE;
    --ldg-component-calendar-cell-selected-color: #1D2630;

    --ldg-bnb-font-family: 'Manrope', system-ui, -apple-system, 'Helvetica Neue', sans-serif;

    /* Portable Search Bar override (kept for future use) */
    --ldg-psb-color-primary: #1E5B73;
    --ldg-psb-color-primary-lighter: #CFE3DE;
    --ldg-psb-color-primary-darker: #143E4E;
    --ldg-psb-color-primary-contrast: #F8F6F1;
    --ldg-semantic-color-primary: #1E5B73;
    --ldg-semantic-color-primary-lighter: #CFE3DE;
    --ldg-semantic-color-primary-darker: #143E4E;
    --ldg-semantic-color-primary-contrast: #F8F6F1;
  }

  #lodgify-book-now-box {
    width: 100%;
  }

  /* Best-effort overrides on the rendered widget DOM. Lodgify's class
     names can change between versions, so these are defensive — they
     target common patterns. Remove if Lodgify ships a CSS-vars-only
     overhaul. */
  #lodgify-book-now-box button[type='submit'],
  #lodgify-book-now-box button[type='button'][class*='primary'],
  #lodgify-book-now-box button[class*='Primary'] {
    background: var(--color-atlantic-blue) !important;
    color: var(--color-warm-white) !important;
    border-radius: 8px !important;
    border: 0 !important;
    font-family: 'Manrope', system-ui, sans-serif !important;
    font-weight: 600 !important;
    transition: background 160ms ease-out;
  }
  #lodgify-book-now-box button[type='submit']:hover,
  #lodgify-book-now-box button[type='button'][class*='primary']:hover,
  #lodgify-book-now-box button[class*='Primary']:hover {
    background: color-mix(in oklch, var(--color-atlantic-blue) 92%, black) !important;
  }
  #lodgify-book-now-box input,
  #lodgify-book-now-box label,
  #lodgify-book-now-box span,
  #lodgify-book-now-box div {
    font-family: 'Manrope', system-ui, sans-serif !important;
  }
</style>

<style>
  /* ----- Booking shell wrapper (when showShell=true) ----- */
  .lodgify-shell {
    background: var(--color-warm-white);
    border: 1px solid #E5DED1;
    border-radius: 14px;
    overflow: hidden;
    margin-top: 24px;
    box-shadow: 0 12px 32px rgba(29, 38, 48, 0.10);
  }
  .lodgify-shell-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding: 14px 22px;
    background: #F1EEE7;
    border-bottom: 1px solid #E5DED1;
    flex-wrap: wrap;
  }
  .lodgify-shell-eye {
    font: 600 12px/1 var(--font-body);
    letter-spacing: 0.06em;
    color: var(--color-deep-navy);
  }
  .lodgify-shell-meta {
    font: 400 12px/1.4 var(--font-body);
    color: var(--color-slate-grey);
  }
  .lodgify-shell-body {
    padding: 22px;
  }
  @media (max-width: 720px) {
    .lodgify-shell-head { padding: 12px 16px; }
    .lodgify-shell-body { padding: 16px; }
  }
</style>
