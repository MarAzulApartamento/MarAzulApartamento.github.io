---
import { getStrings } from '../lib/i18n';
const t = getStrings(Astro.currentLocale);
const places = t.location.places as Array<{ type: string; name: string; distance: string }>;
---

<section class="section section-tint">
  <div class="container">
    <p class="eyebrow">{t.location.eyebrow}</p>
    <h2 class="h2">{t.location.title}</h2>
    <div class="map" aria-label={t.location.mapLabel}>
      <div class="map-grid" aria-hidden="true"></div>
      <div class="map-pin" title="Apartamento Mar Azul">
        <svg viewBox="0 0 24 24" width="28" height="28" fill="currentColor" stroke="var(--color-warm-white)" stroke-width="1.5" aria-hidden="true">
          <path d="M12 2c-3.9 0-7 3.1-7 7 0 5.2 7 13 7 13s7-7.8 7-13c0-3.9-3.1-7-7-7zm0 9.5a2.5 2.5 0 110-5 2.5 2.5 0 010 5z" />
        </svg>
      </div>
      <span class="map-watermark">{t.location.mapPlaceholder}</span>
    </div>
    <ul class="places">
      {places.map((p) => (
        <li class="place">
          <span class="place-type">{p.type}</span>
          <span class="place-name">{p.name}</span>
          <span class="place-dist">{p.distance}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .map {
    position: relative;
    height: 320px;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid #E5DED1;
    margin-top: 24px;
    background: #cfdcd6;
  }
  .map-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(180deg, transparent 0, transparent 32%, #b8cdc4 32%, #b8cdc4 33%, transparent 33%, transparent 100%),
      linear-gradient(90deg, transparent 0, transparent 22%, #b8cdc4 22%, #b8cdc4 22.4%, transparent 22.4%, transparent 100%),
      linear-gradient(45deg, #d6e0d9 0, #d6e0d9 50%, #c5d4cb 50%, #c5d4cb 100%);
    opacity: 0.65;
  }
  .map-pin {
    position: absolute;
    left: 38%;
    top: 44%;
    transform: translate(-50%, -100%);
    color: var(--color-atlantic-blue);
  }
  .map-watermark {
    position: absolute;
    right: 8px;
    bottom: 8px;
    font: 500 11px/1 var(--font-body);
    color: rgba(29, 38, 48, 0.5);
    background: rgba(248, 246, 241, 0.85);
    padding: 4px 7px;
    border-radius: 4px;
  }
  .places {
    list-style: none;
    padding: 0;
    margin: 24px 0 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0;
  }
  .place {
    display: grid;
    grid-template-columns: 110px 1fr auto;
    gap: 14px;
    padding: 12px 0;
    border-bottom: 1px solid #D6CFC0;
    align-items: baseline;
  }
  .place-type {
    font: 600 12px/1 var(--font-body);
    letter-spacing: 0.06em;
    color: var(--color-slate-grey);
  }
  .place-name {
    font: 500 16px/1.3 var(--font-body);
    color: var(--color-deep-navy);
  }
  .place-dist {
    font: 400 14px/1 var(--font-body);
    color: var(--color-slate-grey);
    white-space: nowrap;
  }
  @media (max-width: 720px) {
    .places { grid-template-columns: 1fr; }
  }
</style>
